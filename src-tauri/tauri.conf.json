{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Task Reaper",
  "version": "2.2.0",
  "identifier": "io.github.mba-x86.taskreaper",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Task Reaper",
        "width": 1280,
        "height": 820,
        "minWidth": 1020,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0D0F12",
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --disable-gpu-compositing --in-process-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
